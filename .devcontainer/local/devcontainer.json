{
  "name": "M1S2 Hifimagnet projects (local mount)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },

  "mounts": [
    "source=/home/LNCMI-G/christophe.trophime/LNCMIG-Data/records,target=/mnt/LNCMI-G-Data/records,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "jupyter.notebookEditor.defaultInterpreter": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },

  "postCreateCommand": "chmod +x .devcontainer/setup-basic.sh && ./.devcontainer/setup-basic.sh",

  "remoteUser": "jovyan",

  "forwardPorts": [8866],
  "portsAttributes": {
    "8866": { "label": "Voila App" }
  }
}
