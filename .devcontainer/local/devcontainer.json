{
  "name": "M1S2 Hifimagnet projects (local mount)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },

  
  "runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined",
		"--net",
		"host",
		"-e",
		"DISPLAY=${env:DISPLAY}",
		"-v",
		"/tmp/.X11-unix:/tmp/.X11-unix",
		"-v",
		"${env:HOME}/.Xauthority:/home/feelpp/.Xauthority"//,
		//"--gpus",
		//"all"
	],
  
  "mounts": [
    "source=/mnt/LNCMIG-Data/records,target=/mnt/LNCMI-G-Data/records,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "jupyter.notebookEditor.defaultInterpreter": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },

  "postCreateCommand": "chmod +x .devcontainer/setup-basic.sh && ./.devcontainer/setup-basic.sh",

  "remoteUser": "myuser",

  "forwardPorts": [8866],
  "portsAttributes": {
    "8866": { "label": "Voila App" }
  }
}
