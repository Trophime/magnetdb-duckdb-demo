{
  "name": "MagnetDB duckdb demonstrator (no magnettools)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    // no MagnetTools: the magnettools-db image is not needed
    "target": "base",
    "args": {
      "BASE_IMAGE": "debian:trixie"
    }
  },

  // venvs live outside the workspace so they never mix with the host's .venv;
  // Debian's python3 (3.13): every dependency has a cp313 wheel
  "containerEnv": {
    "VENV_DIR": "/home/myuser/.venvs/magnetdb",
    "VENV_PYTHON": "/usr/bin/python3",
    // same container paths as local/devcontainer.json
    "MAGNETDB_DB_PATH": "/data/duckdb/${localEnv:DUCKDB_NAME:magnetdb.duckdb}",
    "MAGNETDB_DB_DIR": "/data/duckdb",
    "MAGNETDB_RECORDS_DIR": "/mnt/LNCMIG-Data/records",
    "MAGNETDB_SUPERVISION_BDD_CSV": "${containerWorkspaceFolder}/Data/bdd.csv",
    "MAGNETRUN_PUPITRE_DATA_DIR": "/mnt/LNCMIG-Data/records/srv-data-install",
    "MAGNETRUN_PIGBROTHER_DATA_DIR": "/mnt/LNCMIG-Data/records/pbsurv",
    "MAGNETRUN_HYBRID_DATA_DIR": "/mnt/LNCMIG-Data/records/CEA"
  },

  // runs on the host (Linux, macOS or WSL2): creates the mounted dirs below,
  // warns about data still to get from LNCMI staff
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/prepare-host-data.sh\"",

  // host dirs are bind-mounted: data added later shows up without a rebuild
  "mounts": [
    "source=${localEnv:HOME}/magnetdb-duckdb-data/records,target=/mnt/LNCMIG-Data/records,type=bind,consistency=cached",
    "source=${localEnv:HOME}/magnetdb-duckdb-data/duckdb,target=/data/duckdb,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/myuser/.venvs/magnetdb/bin/python"
      }
    }
  },

  "postCreateCommand": "chmod +x .devcontainer/setup-uv.sh && ./.devcontainer/setup-uv.sh",
  "postStartCommand": "[ -d \"$VENV_DIR\" ] || (chmod +x .devcontainer/setup-uv.sh && ./.devcontainer/setup-uv.sh)",

  // Add a remote user (see Dockerfile) 
  // and use it as the default user. On Linux, the container user's GID/UIDs
  // will be updated to match your local UID/GID (when using the dockerFile property).
  // See https://aka.ms/vscode-remote/containers/non-root-user for details.
  // The default user in the base image is "jovyan", so we use that here. 
  // If you change the user in the Dockerfile, make sure to update this value.
  "remoteUser": "myuser",

  "forwardPorts": [8866],
  "portsAttributes": {
    "8866": { "label": "Voila App" }
  }
}
