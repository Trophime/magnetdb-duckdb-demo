{
  "name": "MagnetDB duckdb demonstrator",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "debian:trixie"
    }
  },


  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },

  "postCreateCommand": "chmod +x .devcontainer/setup-basic.sh && ./.devcontainer/setup-basic.sh",
  "postStartCommand": "[ -d .venv ] || (chmod +x .devcontainer/setup-basic.sh && ./.devcontainer/setup-basic.sh)",

  // Add a remote user (see Dockerfile) 
  // and use it as the default user. On Linux, the container user's GID/UIDs
  // will be updated to match your local UID/GID (when using the dockerFile property).
  // See https://aka.ms/vscode-remote/containers/non-root-user for details.
  // The default user in the base image is "jovyan", so we use that here. 
  // If you change the user in the Dockerfile, make sure to update this value.
  "remoteUser": "myuser",

  "forwardPorts": [8866],
  "portsAttributes": {
    "8866": { "label": "Voila App" }
  }
}
